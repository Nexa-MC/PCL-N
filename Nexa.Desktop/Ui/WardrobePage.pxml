<Page xmlns="https://pcln.dev/pxml/2026" Key="AccountWardrobePage" Label="更衣橱">
  <StackPanel Key="WardrobeRoot" Orientation="Horizontal" Weight="1">
    <StackPanel Key="WardrobeProfileRail" Orientation="Vertical" Width="300" Padding="22,18,22,22" Spacing="8" Scroll="true">
      <Text Key="WardrobeCurrentTitle" Content="当前外观" Height="28" />
      <Text Key="WardrobeCurrentSubtitle" Content="皮肤与披风跟随当前选中的账户。" Height="38" />
      <StackPanel Key="WardrobeCurrentCard" Orientation="Vertical" Weight="1" MinHeight="160" Padding="16,12,16,16" Spacing="6">
        <Image Key="WardrobePlayerPreview" Label="当前皮肤与披风全身预览" Source="lucide/image" Weight="1" MinHeight="80" />
        <Button Key="WardrobeCurrentView" Label="切换当前外观视角" Content="正面 · 切换视角" Command="ui.wardrobe.view.current" Height="28" />
        <Text Key="WardrobeIdentity" Content="更衣橱" Height="28" />
        <Text Key="WardrobeProfileKind" Content="请先选择账户" Height="24" />
      </StackPanel>
      <Button Key="WardrobeBrowse" Label="选择本地皮肤" Content="选择本地皮肤" Command="ui.wardrobe.browse" Icon="lucide/image" Height="38" />
      <Button Key="WardrobeLibrary" Label="打开皮肤库" Content="打开皮肤库" Command="ui.wardrobe.library" Icon="lucide/shirt" Height="38" />
      <Button Key="WardrobeManage" Label="打开账户皮肤站" Content="打开账户皮肤站" Command="ui.wardrobe.manage" Icon="lucide/external-link" Height="38" IsVisible="false" />
      <Button Key="WardrobeCancel" Label="取消更衣橱操作" Content="取消操作" Command="ui.wardrobe.cancel" Height="34" IsVisible="false" />
    </StackPanel>
    <StackPanel Key="WardrobeContent" Orientation="Vertical" Weight="1" Padding="26,20,26,24" Spacing="8" Scroll="true">
      <StackPanel Key="WardrobeMainHeader" Orientation="Horizontal" Spacing="10" Height="34">
        <Text Key="WardrobePageTitle" Content="更衣橱" Weight="1" />
        <Button Key="WardrobeRefresh" Label="刷新更衣橱" Content="刷新" Command="ui.wardrobe.refresh" Icon="lucide/refresh-cw" Width="88" Height="34" />
      </StackPanel>
      <Text Key="WardrobeStatus" Content="正在读取当前账户…" Height="40" />
      <StackPanel Key="WardrobeSkinHeader" Orientation="Horizontal" Height="28" Spacing="10">
        <Text Key="WardrobeSkinTitle" Content="皮肤" Weight="1" />
        <Text Key="WardrobeSkinCount" Content="0 项" Width="70" />
      </StackPanel>
      <Text Key="WardrobeSkinSubtitle" Content="此前使用、其他档案与当前账户衣柜中的皮肤。" Height="28" />
      <StackPanel Key="WardrobeSkinTrack" Orientation="Vertical" Weight="1" MinHeight="112">
        <StackPanel Key="WardrobeSkins" Orientation="Horizontal" Weight="1" Spacing="12" Scroll="true" />
        <Text Key="WardrobeSkinsEmpty" Content="还没有发现可展示的皮肤。可以选择本地皮肤或打开皮肤库。" Height="58" IsVisible="false" />
      </StackPanel>
      <StackPanel Key="WardrobeSkinPager" Orientation="Horizontal" Height="28" Spacing="8">
        <Button Key="WardrobeSkinPrevious" Label="向左浏览皮肤" Content="←" Command="ui.wardrobe.skin.previous" Width="38" Height="28" />
        <Button Key="WardrobeSkinNext" Label="向右浏览皮肤" Content="→" Command="ui.wardrobe.skin.next" Width="38" Height="28" />
      </StackPanel>
      <StackPanel Key="WardrobeCapeHeader" Orientation="Horizontal" Height="28" Spacing="10" Margin="0,8,0,0">
        <Text Key="WardrobeCapeTitle" Content="披风" Weight="1" />
        <Text Key="WardrobeCapeCount" Content="0 项" Width="70" />
      </StackPanel>
      <Text Key="WardrobeCapeSubtitle" Content="当前、历史和其他档案中发现的披风。" Height="30" />
      <StackPanel Key="WardrobeCapeTrack" Orientation="Vertical" Weight="1" MinHeight="112">
        <StackPanel Key="WardrobeCapes" Orientation="Horizontal" Weight="1" Spacing="12" Scroll="true" />
        <Text Key="WardrobeCapeStatus" Content="正在读取披风…" Height="64" IsVisible="false" />
      </StackPanel>
      <StackPanel Key="WardrobeCapePager" Orientation="Horizontal" Height="30" Spacing="8">
        <Button Key="WardrobeCapePrevious" Label="向左浏览披风" Content="←" Command="ui.wardrobe.cape.previous" Width="38" Height="28" />
        <Button Key="WardrobeCapeNext" Label="向右浏览披风" Content="→" Command="ui.wardrobe.cape.next" Width="38" Height="28" />
        <Button Key="WardrobeCapeClear" Label="关闭当前披风" Content="关闭披风" Command="ui.wardrobe.cape.clear" Width="112" Height="28" />
      </StackPanel>
    </StackPanel>
    <ContentHost Key="WardrobeLocalLayer" Label="本地皮肤选择" IsVisible="false">
      <Dialog Key="WardrobeLocalPanel" Label="选择本地皮肤" Orientation="Vertical" Width="600" MaxHeight="500" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20" Spacing="10" Scroll="true">
        <Text Key="WardrobeLocalTitle" Content="选择本地皮肤" Height="28" />
        <Text Content="支持 64×64 或经典模型的 64×32 PNG 皮肤，最大 1 MiB。" Height="40" />
        <StackPanel Key="WardrobePreviews" Orientation="Horizontal" Height="110" Spacing="20">
          <Image Key="WardrobeHeadPreview" Label="选择的皮肤头像预览" Source="pcl/avatar/steve" Width="100" Height="100" />
          <Image Key="WardrobeTexturePreview" Label="选择的皮肤 PNG 预览" Source="lucide/image" Width="100" Height="100" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" Height="38">
          <TextInput Key="WardrobeSkinPath" Label="皮肤 PNG 文件路径" Placeholder="皮肤 PNG 文件路径" Height="38" Weight="1" />
          <Button Key="WardrobeChooseFile" Label="选择皮肤文件" Content="选择文件" Command="ui.wardrobe.browse" Width="100" Height="38" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="8" Height="36">
          <Button Key="WardrobeClassic" Label="经典皮肤模型" Content="✓  经典模型" Command="ui.wardrobe.classic" Weight="1" Height="36" />
          <Button Key="WardrobeSlim" Label="纤细皮肤模型" Content="纤细模型" Command="ui.wardrobe.slim" Weight="1" Height="36" />
        </StackPanel>
        <Text Key="WardrobeLocalStatus" Content="选择文件并确认手臂模型后上传。" Height="40" />
        <StackPanel Orientation="Horizontal" Spacing="8" Height="36">
          <Button Key="WardrobeLocalClose" Label="关闭本地皮肤选择" Content="取消" Command="ui.wardrobe.local.close" Width="96" Height="36" />
          <Button Key="WardrobePreview" Label="校验并预览皮肤" Content="校验并预览" Command="ui.wardrobe.preview" Weight="1" Height="36" />
          <Button Key="WardrobeUpload" Label="上传预览的皮肤" Content="上传皮肤" Command="ui.wardrobe.upload" Width="112" Height="36" />
        </StackPanel>
      </Dialog>
    </ContentHost>
  </StackPanel>
</Page>
